{
  "name": "@ainex/web",
  "version": "0.2.0",
  "private": true,
  "description": "AINEX Archive learner, manager and admin SPA (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test:e2e-guard": "node --test e2e/stack.test.mjs",
    "e2e:stack": "node e2e/stack.mjs"
  },
  "dependencies": {
    "@ainex/contracts": "*",
    "@radix-ui/react-select": "^2.4.1",
    "@tanstack/react-query": "^5.90.0",
    "framer-motion": "^12.23.0",
    "hls.js": "1.5.17",
    "lucide-react": "^1.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "mysql2": "^3.24.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
