{
  "//": "Typecheck for the Playwright e2e harness (npm run typecheck:e2e). Kept apart from tsconfig.json so the SPA build never sees node-only code.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": false,
    "types": ["node"]
  },
  "include": ["./**/*.ts", "../playwright.config.ts"]
}
